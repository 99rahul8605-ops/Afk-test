# AFK bot
BOT_TOKEN=
API_ID=
API_HASH=
BOT_USERNAME=
MONGODB_URI=
OWNER_ID=
PORT=8080

# Verification Mini App public HTTPS base URL, no trailing slash
# Example: https://my-afk-verify.onrender.com
# Optional outside Render. On Render, RENDER_EXTERNAL_URL is used automatically.
VERIFY_URL=

# Verification groups are managed from Telegram by the owner:
# /addverifygroup inside a group
# /removeverifygroup inside a group
# /verifygroups to list configured groups
VERIFY_HOST=0.0.0.0
VERIFY_PORT=8081
INITDATA_MAX_AGE=900
AUTO_BAN_HIGH_RISK=true
TRUST_PROXY_HEADERS=true
MATCH_LIMIT=40
