# Existing bot values can be reused
BOT_TOKEN=
MONGODB_URI=
OWNER_ID=

# Verification groups are stored in MongoDB and managed through the bot.
# No VERIFY_GROUP_ID environment variable is needed.

# Verification web server
VERIFY_HOST=0.0.0.0
VERIFY_PORT=8081

# Telegram Mini App initData validity, seconds
INITDATA_MAX_AGE=900

# Auto-ban when the exact same device fingerprint has a Telegram ID currently banned in a configured group
AUTO_BAN_HIGH_RISK=true

# Keep true on Render/Cloudflare/Nginx-style reverse proxy deployments.
# Set false if users connect directly to Flask.
TRUST_PROXY_HEADERS=true

MATCH_LIMIT=40
